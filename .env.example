# Copy to .env and fill in. .env is gitignored.

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NVIDIA Nemotron (build.nvidia.com -> API key)
# Server-side only. Do NOT prefix with VITE_ or it ships to the browser.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1

# Photon 2.0 (app.photon.codes -> your project -> ID and secret)
# Run the iMessage bridge with: npm run imessage
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
